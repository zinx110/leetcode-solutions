{
    "description": "Test cases for 78. Subsets",
    "tests": [
        {
            "input": {
                "nums": [1, 2, 3]
            },
            "expectedOutput": [
                [], [1], [2], [3], [1, 2], [1, 3], [2, 3], [1, 2, 3]
            ]
        },
        {
            "input": {
                "nums": [0]
            },
            "expectedOutput": [
                [], [0]
            ]
        },
        {
            "input": {
                "nums": [1, 2]
            },
            "expectedOutput": [
                [], [1], [2], [1, 2]
            ]
        }
    ],
    "constraints": {
        "nums.length": {"min": 1, "max": 10},
        "nums[i]": {"min": -10, "max": 10},
        "unique": true
    }
}
