{
    "description": "Test cases for 105. Construct Binary Tree from Preorder and Inorder Traversal",
    "tests": [
        {
            "input": {
                "preorder": [3, 9, 20, 15, 7],
                "inorder": [9, 3, 15, 20, 7]
            },
            "expectedOutput": [3, 9, 20, null, null, 15, 7]
        },
        {
            "input": {
                "preorder": [-1],
                "inorder": [-1]
            },
            "expectedOutput": [-1]
        },
        {
            "input": {
                "preorder": [1, 2],
                "inorder": [2, 1]
            },
            "expectedOutput": [1, 2]
        },
        {
            "input": {
                "preorder": [1, 2],
                "inorder": [1, 2]
            },
            "expectedOutput": [1, null, 2]
        },
        {
            "input": {
                "preorder": [1, 2, 3, 4, 5, 6, 7],
                "inorder": [4, 3, 5, 2, 6, 1, 7]
            },
            "expectedOutput": [1, 2, 7, 3, 6, 4, 5]
        }
    ],
    "constraints": {
        "arrayLength": {"min": 1, "max": 3000},
        "nodeValue": {"min": -3000, "max": 3000},
        "uniqueValues": true
    }
}


